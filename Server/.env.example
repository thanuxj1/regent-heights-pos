# Copy to .env and fill in. .env is never committed; this file is.
#
# Required — the server refuses to start without these two.
# ---------------------------------------------------------------------------

# Postgres. Neon's pooled connection string works as it comes.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# What signs every session token. Any long random string; changing it signs
# everyone out. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Strongly recommended in production
# ---------------------------------------------------------------------------

# Where the app is served from — the only site allowed to call this API from a
# browser. Several may be listed, comma separated. Leave it unset and the API
# answers only pages served from its own address (in development it accepts
# anything, which is what lets Vite on :3000 talk to :5000).
CLIENT_URL=http://localhost:3000

# "production" turns off development conveniences, including the open CORS
# above. Set it on the real server.
NODE_ENV=development

# Behind nginx, Render or Cloudflare the socket address is the proxy's, so the
# rate limiter would see every guest as one client. Set this to the number of
# proxies in front of the server (usually 1). Leave it unset in development.
# Never set it to "true" blindly: that lets anyone forge X-Forwarded-For.
# TRUST_PROXY=1

# Optional — sensible defaults if unset
# ---------------------------------------------------------------------------

# The port the API listens on. Default 5000.
PORT=5000

# How long a session token lasts. Default 7d.
JWT_EXPIRE=7d

# The property's own clock. Every "today" — the day's takings, the kitchen
# board, a stock count — is worked out in this zone. Default Asia/Colombo.
HOTEL_TZ=Asia/Colombo

# What encrypts the cash drawer PIN. Falls back to JWT_SECRET, which is fine;
# set it separately if the PIN should survive a JWT_SECRET rotation.
# DRAWER_PIN_KEY=

# How long the activity log is kept before the nightly trim, in months.
# Default 24; 0 keeps everything forever.
# ACTIVITY_RETENTION_MONTHS=12

# What counts as a drawer that does not balance, in rupees. Default 100.
# CASH_VARIANCE_LIMIT=100
