# Copy to .env and fill in. .env is never committed; this file is.
#
# Vite reads these at build time, not at run time: a change here needs a
# rebuild, and anything written here ends up inside the JavaScript the browser
# downloads. Never put a secret in this file.

# Where the API is. Leave it unset and the app calls /api on whatever address
# it was served from — which is right when the server serves the built app
# itself, and right in development, where it falls back to localhost:5000.
# Set it when the app and the API live at different addresses.
VITE_API_URL=http://localhost:5000/api

# Where Socket.IO connects, if that is somewhere other than VITE_API_URL
# without its /api. Live updates — the kitchen board, a new ticket at the till
# — come over this. Usually left unset.
# VITE_SOCKET_URL=http://localhost:5000
